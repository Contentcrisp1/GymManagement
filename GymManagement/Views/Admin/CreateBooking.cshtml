
@model GymManagement.Models.ViewModels.AdminCreateBookingViewModel

@{
    ViewData["Title"] = "Create Booking";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Create Booking
            </h1>

            <p class="text-muted mb-0">
                Book a member into a gym class.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Bookings"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Bookings

        </a>

    </div>


    <div class="row">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        New Booking
                    </h4>


                    <form asp-action="CreateBooking"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- MEMBER -->

                        <div class="mb-4">

                            <label asp-for="MemberId"
                                   class="form-label fw-semibold">

                                Member

                            </label>

                            <select asp-for="MemberId"
                                    asp-items="Model.Members"
                                    class="form-select">

                                <option value="">
                                    -- Select Member --
                                </option>

                            </select>

                            <span asp-validation-for="MemberId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CLASS -->

                        <div class="mb-4">

                            <label asp-for="GymClassId"
                                   class="form-label fw-semibold">

                                Gym Class

                            </label>

                            <select asp-for="GymClassId"
                                    asp-items="Model.Classes"
                                    class="form-select">

                                <option value="">
                                    -- Select Class --
                                </option>

                            </select>

                            <span asp-validation-for="GymClassId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-calendar-plus me-1"></i>
                                Create Booking

                            </button>

                            <a asp-action="Bookings"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

