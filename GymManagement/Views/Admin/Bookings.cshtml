
@model IEnumerable<GymManagement.Models.ClassBooking>

@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Manage Bookings
            </h1>

            <p class="text-muted mb-0">
                View and manage all gym class bookings.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Dashboard

            </a>

            <a asp-controller="Admin"
               asp-action="CreateBooking"
               class="btn btn-success">

                <i class="bi bi-plus-lg me-1"></i>
                Create Booking

            </a>

        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- BOOKINGS -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h4 class="mt-3">
                        No bookings found
                    </h4>

                    <p class="text-muted">
                        There are currently no class bookings.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="CreateBooking"
                       class="btn btn-success">

                        <i class="bi bi-plus-lg me-1"></i>
                        Create First Booking

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                        <tr>

                            <th>
                                Class
                            </th>

                            <th>
                                Member
                            </th>

                            <th>
                                Trainer
                            </th>

                            <th>
                                Class Time
                            </th>

                            <th>
                                Booked At
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                        </thead>

                        <tbody>

                        @foreach (var booking in Model)
                        {
                            <tr>

                                <!-- CLASS -->

                                <td>

                                    <strong>
                                        @booking.GymClass.Name
                                    </strong>

                                </td>


                                <!-- MEMBER -->

                                <td>

                                    @booking.Member.FirstName
                                    @booking.Member.LastName

                                </td>


                                <!-- TRAINER -->

                                <td>

                                    @booking.GymClass.Trainer.FirstName
                                    @booking.GymClass.Trainer.LastName

                                </td>


                                <!-- CLASS TIME -->

                                <td>

                                    <div>
                                        @booking.GymClass.StartTime.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @booking.GymClass.StartTime.ToString("HH:mm")
                                    </small>

                                </td>


                                <!-- BOOKED AT -->

                                <td>

                                    @booking.BookedAt.ToString("dd MMM yyyy HH:mm")

                                </td>


                                <!-- DELETE -->

                                <td class="text-end">

                                    <form asp-controller="Admin"
                                          asp-action="DeleteBooking"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Cancel this booking?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">

                                            <i class="bi bi-trash me-1"></i>
                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

