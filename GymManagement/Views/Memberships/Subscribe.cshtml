@model GymManagement.Models.MembershipType

@{
    ViewData["Title"] = "Subscribe";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Subscribe to Membership</h3>
                </div>

                <div class="card-body">

                    <h4>@Model.Name</h4>

                    <p class="text-muted">
                        @Model.Description
                    </p>

                    <hr />

                    <div class="row mb-3">

                        <div class="col-md-6">
                            <strong>Price:</strong>
                            <br />
                            <span class="fs-4 text-success">
                                $@Model.Price
                            </span>
                        </div>

                        <div class="col-md-6">
                            <strong>Duration:</strong>
                            <br />
                            <span class="fs-5">
                                @Model.DurationInDays days
                            </span>
                        </div>

                    </div>

                    <div class="alert alert-info">
                        <strong>Important:</strong>
                        Your membership will start immediately after confirmation
                        and will remain active for @Model.DurationInDays days.
                    </div>

                    <form asp-action="SubscribeConfirmed"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">
                                Confirm Subscription
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>