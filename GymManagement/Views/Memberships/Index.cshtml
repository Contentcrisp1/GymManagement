@model IEnumerable<GymManagement.Models.MembershipType>

@{
    ViewData["Title"] = "Membership Plans";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Membership Plans</h2>

        @if (User.Identity!.IsAuthenticated)
        {
            <a asp-action="MySubscription" class="btn btn-outline-primary">
                My Subscription
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No membership plans are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var plan in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">@plan.Name</h4>
                        </div>

                        <div class="card-body">

                            <p class="text-muted">
                                @plan.Description
                            </p>

                            <hr />

                            <h3 class="text-success">
                                $@plan.Price
                            </h3>

                            <p>
                                <strong>Duration:</strong>
                                @plan.DurationInDays days
                            </p>

                        </div>

                        <div class="card-footer bg-white">

                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-action="Subscribe"
                                   asp-route-id="@plan.Id"
                                   class="btn btn-success w-100">
                                    Subscribe
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   class="btn btn-primary w-100">
                                    Login to Subscribe
                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>