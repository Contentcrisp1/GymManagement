@model IEnumerable<GymManagement.Models.MembershipType>

@{
    ViewData["Title"] = "Manage Membership Plans";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Membership Plans</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- SEARCH -->

    <form asp-action="Manage" method="get" class="row mb-4">

        <div class="col-md-8">
            <input
                type="text"
                name="search"
                value="@ViewBag.Search"
                class="form-control"
                placeholder="Search membership plan..." />
        </div>

        <div class="col-md-2">
            <button class="btn btn-primary w-100">
                Search
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="Manage"
               class="btn btn-secondary w-100">
                Clear
            </a>
        </div>

    </form>

    <!-- CREATE -->

    <div class="card mb-5">

        <div class="card-header bg-success text-white">
            <strong>Create Membership Plan</strong>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label>Name</label>

                    <input
                        name="Name"
                        class="form-control"
                        required />
                </div>

                <div class="mb-3">
                    <label>Description</label>

                    <textarea
                        name="Description"
                        class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label>Price</label>

                    <input
                        type="number"
                        step="0.01"
                        min="1"
                        name="Price"
                        class="form-control"
                        required />
                </div>

                <div class="mb-3">
                    <label>Duration (Days)</label>

                    <input
                        type="number"
                        min="1"
                        name="DurationInDays"
                        class="form-control"
                        required />
                </div>

                <button class="btn btn-success">
                    Create Membership
                </button>

            </form>

        </div>

    </div>

    <!-- TABLE -->

    <table class="table table-bordered table-hover">

        <thead class="table-dark">

        <tr>

            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Duration</th>
            <th width="180">Actions</th>

        </tr>

        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Name</td>

                <td>@item.Description</td>

                <td>$@item.Price</td>

                <td>@item.DurationInDays days</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

        </tbody>

    </table>

</div>