@model GymManagement.Models.ViewModels.CreateUserViewModel

@{
ViewData["Title"] = "Create User";
}

<div class="container py-4">


<!-- Back -->
<div class="mb-4">

    <a asp-action="Index"
       class="text-decoration-none">

        <i class="bi bi-arrow-left me-1"></i>
        Back to User Management

    </a>

</div>

<div class="row justify-content-center">

    <div class="col-lg-6 col-xl-5">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                <!-- Header -->
                <div class="text-center mb-4">

                    <div class="create-user-icon mx-auto mb-3">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>

                    <h2 class="fw-bold mb-1">
                        Create User
                    </h2>

                    <p class="text-muted mb-0">
                        Create a new gym system account.
                    </p>

                </div>

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <!-- Email -->
                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                            Email Address
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="user@example.com"
                                   autocomplete="off" />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- Password -->
                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Minimum 6 characters"
                                   autocomplete="new-password" />

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            The password must satisfy your Identity password requirements.
                        </div>

                    </div>

                    <!-- Role -->
                    <div class="mb-4">

                        <label asp-for="Role"
                               class="form-label fw-semibold">
                            User Role
                        </label>

                        <select asp-for="Role"
                                class="form-select">

                            @if (Model.Roles.Any())
                            {
                                foreach (var role in Model.Roles)
                                {
                                    <option value="@role">
                                        @role
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="Member">
                                    Member
                                </option>
                            }

                        </select>

                        <div class="form-text">
                            Admin users can access the administration dashboard.
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="d-flex gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary flex-fill">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary flex-fill">

                            <i class="bi bi-person-plus-fill me-1"></i>
                            Create User

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


</div>

<style>

    .create-user-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 1.6rem;
    }

</style>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
