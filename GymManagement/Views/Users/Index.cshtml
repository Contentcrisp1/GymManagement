@model IEnumerable<GymManagement.Models.ViewModels.AdminUserViewModel>

@{
ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">


<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

    <div>
        <div class="text-uppercase small fw-semibold text-primary mb-1">
            Administration
        </div>

        <h1 class="fw-bold mb-1">
            User Management
        </h1>

        <p class="text-muted mb-0">
            Create and manage gym system accounts.
        </p>
    </div>

    <div class="mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i>
            Create User
        </a>
    </div>

</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<!-- Users Card -->
<div class="card border-0 shadow-sm">

    <div class="card-header bg-white border-0 p-4">

        <div class="d-flex align-items-center">

            <div class="user-header-icon me-3">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <h5 class="fw-bold mb-1">
                    System Users
                </h5>

                <p class="text-muted small mb-0">
                    Manage administrator and member accounts.
                </p>
            </div>

        </div>

    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-people display-4 text-muted"></i>

                <h4 class="mt-3">
                    No users found
                </h4>

                <p class="text-muted">
                    Create the first system user.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i>
                    Create User
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                    <tr>
                        <th class="ps-4">
                            User
                        </th>

                        <th>
                            Role
                        </th>

                        <th class="text-end pe-4">
                            Actions
                        </th>
                    </tr>

                    </thead>

                    <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <!-- User -->
                            <td class="ps-4">

                                <div class="d-flex align-items-center">

                                    <div class="user-avatar me-3">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <div>

                                        <div class="fw-semibold">
                                            @user.Email
                                        </div>

                                        <small class="text-muted">
                                            @user.Id
                                        </small>

                                    </div>

                                </div>

                            </td>

                            <!-- Role -->
                            <td>

                                @if (user.Roles.Contains("Admin"))
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-shield-fill me-1"></i>
                                        Admin
                                    </span>
                                }
                                else if (user.Roles.Contains("Member"))
                                {
                                    <span class="badge bg-primary">
                                        <i class="bi bi-person-fill me-1"></i>
                                        Member
                                    </span>
                                }
                                else if (user.Roles.Any())
                                {
                                    foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No Role
                                    </span>
                                }

                            </td>

                            <!-- Actions -->
                            <td class="text-end pe-4">

                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this user?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash me-1"></i>
                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<!-- Back -->
<div class="mt-4">

    <a asp-controller="Admin"
       asp-action="Dashboard"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to Dashboard

    </a>

</div>


</div>

<style>

    .user-header-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 1.2rem;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2f7;
        color: #495057;
    }

    .table > :not(caption) > * > * {
        padding-top: 16px;
        padding-bottom: 16px;
    }

</style>
