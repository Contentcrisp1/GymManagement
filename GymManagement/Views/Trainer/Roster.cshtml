@model GymManagement.Models.ViewModels.TrainerRosterViewModel

@{
    ViewData["Title"] = "Class Roster";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>

            <h1>@Model.ClassName</h1>

            <p class="text-muted mb-1">

                <strong>Trainer:</strong>
                @Model.TrainerName

            </p>

            @if (!string.IsNullOrWhiteSpace(Model.TrainerSpecialization))
            {
                <p class="text-muted mb-1">

                    <strong>Specialization:</strong>
                    @Model.TrainerSpecialization

                </p>
            }

            <p class="text-muted mb-0">

                @(Model.StartTime.ToLocalTime().ToString("dddd, dd MMMM yyyy"))

                at

                @(Model.StartTime.ToLocalTime().ToString("HH:mm"))

                ·

                @Model.DurationInMinutes minutes

            </p>

        </div>

        <a asp-controller="Trainer"
           asp-action="Schedule"
           class="btn btn-outline-secondary">
            Back to Schedule
        </a>

    </div>

    <!-- SUCCESS MESSAGE -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- ROSTER -->

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Registered Members
            </h5>

            <span class="badge bg-primary">
                @Model.Members.Count / @Model.MaxCapacity
            </span>

        </div>

        <div class="card-body">

            @if (!Model.Members.Any())
            {
                <div class="text-center py-5">

                    <h5>No Members Registered</h5>

                    <p class="text-muted mb-0">
                        There are currently no members registered
                        for this class.
                    </p>

                </div>
            }
            else
            {
                <form asp-controller="Trainer"
                      asp-action="MarkAttendance"
                      method="post">

                    <input type="hidden"
                           name="classId"
                           value="@Model.ClassId" />

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>

                                <tr>

                                    <th>
                                        Attended
                                    </th>

                                    <th>
                                        Member
                                    </th>

                                    <th>
                                        Registered
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var member in Model.Members)
                                {
                                    <tr>

                                        <!-- ATTENDANCE CHECKBOX -->

                                        <td>

                                            <div class="form-check">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="attendedBookingIds"
                                                       value="@member.BookingId"
                                                       id="booking_@member.BookingId"
                                                       @(member.Attended
                                                           ? "checked"
                                                           : "") />

                                                <label class="form-check-label"
                                                       for="booking_@member.BookingId">

                                                    Mark attended

                                                </label>

                                            </div>

                                        </td>

                                        <!-- MEMBER -->

                                        <td>

                                            <strong>
                                                @member.MemberName
                                            </strong>

                                        </td>

                                        <!-- BOOKING DATE -->

                                        <td>

                                            @(member.BookedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm"))

                                        </td>

                                        <!-- STATUS -->

                                        <td>

                                            @if (member.Attended)
                                            {
                                                <span class="badge bg-success">
                                                    Attended
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Not Attended
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="mt-3">

                        <button type="submit"
                                class="btn btn-success">
                            Save Attendance
                        </button>

                    </div>

                </form>
            }

        </div>

    </div>

</div>