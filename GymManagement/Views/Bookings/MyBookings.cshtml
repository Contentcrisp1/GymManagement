@model IEnumerable<GymManagement.Models.ClassBooking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="mb-1">My Bookings</h1>
        <p class="text-muted mb-0">The classes you have reserved.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Bookings" asp-action="Index">Book a Class</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not booked any classes yet.
        <a asp-controller="Bookings" asp-action="Index">Browse upcoming classes</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Class</th>
                <th>Trainer</th>
                <th>Starts</th>
                <th>Duration</th>
                <th>Booked On</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var booking in Model)
            {
                var trainer = booking.GymClass.Trainer;
                var trainerName = trainer is not null ? $"{trainer.FirstName} {trainer.LastName}" : "Unassigned";
                var isUpcoming = booking.GymClass.StartTime >= DateTime.UtcNow;

                <tr>
                    <td class="fw-semibold">@booking.GymClass.Name</td>
                    <td>@trainerName</td>
                    <td>@booking.GymClass.StartTime.ToString("ddd, dd MMM yyyy HH:mm")</td>
                    <td>@booking.GymClass.DurationInMinutes min</td>
                    <td>@booking.BookedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (isUpcoming)
                        {
                            <span class="badge bg-success">Upcoming</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Completed</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (isUpcoming)
                        {
                            <form asp-controller="Bookings" asp-action="Cancel" method="post"
                                  onsubmit="return confirm('Cancel your booking for @booking.GymClass.Name?');">
                                <input type="hidden" name="id" value="@booking.Id"/>
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Booking</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">&mdash;</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
